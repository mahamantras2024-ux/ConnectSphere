DB_HOST=localhost
DB_PORT=5432
DB_NAME=connectsphere
DB_USER=connectsphere
DB_PASSWORD=connectsphere
# Set true for Supabase. Keep false for local Docker PostgreSQL.
DB_SSL=false
# Optional absolute path to the provider's root certificate if required.
# DB_SSL_CA_PATH=/absolute/path/to/prod-supabase.cer
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Local development: inspect captured emails at http://localhost:8025.
MAIL_PROVIDER=mailpit
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025
PUBLIC_APP_URL=http://localhost:5173
# Real inbox delivery: set MAIL_PROVIDER=resend, a verified sender and HTTPS URL.
# MAIL_FROM=Event Portal <notifications@your-verified-domain.example>
# RESEND_API_KEY=your-private-api-key
